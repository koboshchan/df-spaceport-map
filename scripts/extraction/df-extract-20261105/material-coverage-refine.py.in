  else:status='no_MI_parameter_proof' if sole else 'MI_identity_ambiguous_or_unmatched';selected=None;image_pending[im]+=1
  slots.append(dict(blender_material=m['name'],blender_image=im,DF_MI=sole,MI_candidates=cs,texture_candidates=sorted(candidates),canonical_MI_reference_intersection=intersect,context_status=status,selected_candidate_for_report_only=selected,parameter_evidence=refs.get(selected,[]),application_approved=False,shader_slot_semantics='unknown_until_actual_root_function_graph_trace'))
 mrow['context_verified_texture_associations']=sum(s['context_status']=='unique_canonical_MI_parameter_context' for s in slots if s['blender_material']==m['name'])
