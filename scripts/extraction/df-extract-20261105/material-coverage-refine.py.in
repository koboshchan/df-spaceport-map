def canonical(ref):
 if not isinstance(ref,dict):return None
 p=ref.get('ObjectPath')
 return p.rsplit('.',1)[0] if p else None
# Explicit inherited scalar/vector/texture values already resolved. Add active static overrides, and property overrides only when cooked activation flag exists.
alpha_keys={'BlendMode':['bOverride_BlendMode'],'OpacityMaskClipValue':['bOverride_OpacityMaskClipValue'],'TwoSided':['bOverride_TwoSided'],'ShadingModel':['bOverride_ShadingModel'],'ShadingModels':['bOverride_ShadingModel']}
static=[]
for key,e in eff.items():
 prop={k:dict(status='unknown_not_explicit',value=None) for k in alpha_keys};switches={};layers=[]
 for ck in reversed(e['parent_chain']):
  d=objs.get(ck,{});p=d.get('Properties',{});bp=p.get('BasePropertyOverrides',{})
  if d.get('Type')=='Material':
   for k in prop:
    alias='bTwoSided' if k=='TwoSided' and 'bTwoSided' in p else k
    if alias in p:prop[k]=dict(status='explicit_base_property',value=p[alias],source=ck)
  for k,fl in alpha_keys.items():
   active=next((f for f in fl if bp.get(f) is True),None)
   if active and k in bp:prop[k]=dict(status='active_explicit_MI_override',value=bp[k],source=ck,activation_flag=active)
   elif k in bp:layers.append(dict(source=ck,property=k,value=bp[k],status='not_effective_without_explicit_activation_flag',activation_flags={f:bp.get(f,'absent') for f in fl}))
  def collect(x,trail=''):
   if isinstance(x,dict):
    for k,v in x.items():
     if k in ('StaticSwitchParameters','StaticComponentMaskParameters') and isinstance(v,list):
      for q in v:
       pi=q.get('ParameterInfo',{});sid=(k,pi.get('Name',q.get('ParameterName')),pi.get('Association'),pi.get('Index'))
       static.append(dict(material=key,source=ck,container=trail+'.'+k,raw=q))
       if q.get('bOverride') is True:switches[str(sid)]=dict(source=ck,raw=q,status='explicit_active_override')
     collect(v,trail+'.'+k)
   elif isinstance(x,list):
    for v in x:collect(v,trail)
  collect(p)
 e['effective_alpha_shading_explicit']=prop;e['inactive_or_unknown_property_override_evidence']=layers;e['effective_static_overrides']=switches
