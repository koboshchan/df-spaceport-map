import pathlib,sys,os,json,hashlib,subprocess,shutil,datetime,traceback
R=pathlib.Path('@@DF_PATH_DF_V26_BUILD_20261106@@');S=R/'central-stage-17052918';G=S/'game/kat';Q=S/'packqa';Q.mkdir(exist_ok=True);sys.stdout=(Q/'worker.log').open('w',buffering=1);sys.stderr=sys.stdout
def save(n,x):(Q/n).write_text(json.dumps(x,indent=2))
