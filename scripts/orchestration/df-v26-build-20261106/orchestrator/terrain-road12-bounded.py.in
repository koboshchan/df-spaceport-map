from pathlib import Path
import json,hashlib,struct
O=Path('@@DF_PATH_DF_V26_BUILD_20261106@@/terrain-stage');G=Path('@@DF_PATH_DF_V25_BUILD_20261106@@')
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
