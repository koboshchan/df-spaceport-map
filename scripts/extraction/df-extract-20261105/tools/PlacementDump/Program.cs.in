using System.Text.Json;
using System.Diagnostics;
using System.Reflection;
using System.Security.Cryptography;
using CUE4Parse.FileProvider;
using CUE4Parse.UE4.Versions;
using CUE4Parse.Encryption.Aes;
using CUE4Parse.Compression;
using CUE4Parse.UE4.Assets;
using CUE4Parse.UE4.Assets.Exports.Texture;

using CUE4Parse.UE4.Assets.Exports.Material;
using CUE4Parse_Conversion;
using CUE4Parse_Conversion.Options;
using CUE4Parse_Conversion.Textures;
using CUE4Parse_Conversion.Exporters;
using Serilog;
Log.Logger=new LoggerConfiguration().MinimumLevel.Error().WriteTo.Console().CreateLogger();
var root=@"@@DF_PATH_DF_EXTRACT_20261105@@";
var output=Path.Combine(root,"placements");
Directory.CreateDirectory(output);
const long cap=60_000_000_000L;
long used=Directory.EnumerateFiles(root,"*",SearchOption.AllDirectories).Sum(f=>new FileInfo(f).Length);
var lastCheck=DateTime.MinValue;
void Check(bool force=false){
 if(used>cap-256_000_000)throw new OperationCanceledException("60GB cumulative cap reached");
 if(new DriveInfo("E").AvailableFreeSpace<20_000_000_000L)throw new OperationCanceledException("20GB disk reserve reached");
 if(!force && (DateTime.UtcNow-lastCheck).TotalSeconds<10)return;
 var psi=new ProcessStartInfo("powershell.exe"){UseShellExecute=false,RedirectStandardOutput=true,RedirectStandardError=true,CreateNoWindow=true};
 psi.ArgumentList.Add("-NoProfile");psi.ArgumentList.Add("-File");psi.ArgumentList.Add(Path.Combine(output,"guard.ps1"));
 using var proc=Process.Start(psi)!;var result=proc.StandardOutput.ReadToEnd();proc.WaitForExit();
 if(proc.ExitCode!=0)throw new OperationCanceledException("DF/ACE guard stop "+result);
 lastCheck=DateTime.UtcNow;
}
void Write(string relative,byte[] bytes){
 Check(); var path=Path.GetFullPath(Path.Combine(output,relative));
 if(!path.StartsWith(output+Path.DirectorySeparatorChar,StringComparison.OrdinalIgnoreCase))throw new Exception("unsafe output path");
 if(used+bytes.LongLength+256_000_000>cap)throw new OperationCanceledException("60GB cumulative cap");
 Directory.CreateDirectory(Path.GetDirectoryName(path)!); File.WriteAllBytes(path,bytes); used+=bytes.LongLength;
}
void Json(string relative,object value)=>Write(relative,System.Text.Encoding.UTF8.GetBytes(JsonSerializer.Serialize(value,new JsonSerializerOptions{IncludeFields=true})));
void Append(string relative,object value){
 Check();var text=JsonSerializer.Serialize(value,new JsonSerializerOptions{IncludeFields=true})+Environment.NewLine;
 var bytes=System.Text.Encoding.UTF8.GetByteCount(text);if(used+bytes+16_000_000>cap)throw new OperationCanceledException("60GB cap");
 File.AppendAllText(Path.Combine(output,relative),text);used+=bytes;
}
Check(true);
File.WriteAllText(Path.Combine(output,"worker.pid"),Environment.ProcessId.ToString());
var index=new Dictionary<string,Entry>(StringComparer.OrdinalIgnoreCase);
foreach(var line in File.ReadLines(Path.Combine(root,"index-manifest.jsonl"))){
 using var doc=JsonDocument.Parse(line);var e=doc.RootElement;
 index[e.GetProperty("path").GetString()!]=new(e.GetProperty("path").GetString()!,e.GetProperty("pak").GetString()!,e.GetProperty("size").GetInt64());
}
OodleHelper.Initialize(Path.Combine(root,"tools","oodle-data-shared.dll"));

using var kj=JsonDocument.Parse(File.ReadAllText(Path.Combine(root,"community-aes-keys.json")));
var keys=kj.RootElement.GetProperty("Keys").EnumerateArray().GroupBy(x=>x.GetProperty("guid").GetString()).Select(g=>g.First()).ToDictionary(x=>x.GetProperty("guid").GetString()!.Replace("-","").ToUpperInvariant(),x=>x.GetProperty("key").GetString()!);
keys["00000000000000000000000000000000"]=kj.RootElement.GetProperty("MainKey").GetString()!;
using var p=new StreamedFileProvider("DeltaForce",new VersionContainer(EGame.GAME_DeltaForce),StringComparer.OrdinalIgnoreCase);p.Initialize();
foreach(var pak in File.ReadAllLines(Path.Combine(root,"pak-paths.txt"))){Check();p.RegisterVfs(pak.Trim());}
foreach(var r in p.UnloadedVfs.ToArray()){Check();var guid=r.EncryptionKeyGuid.ToString().Replace("-","").ToUpperInvariant();if(keys.TryGetValue(guid,out var key))p.SubmitKey(r.EncryptionKeyGuid,new FAesKey(key));}

CUE4Parse.UE4.Assets.ObjectTypeRegistry.RegisterClass("VirtualMaterialInstanceConstant",typeof(CUE4Parse.GameTypes.DFHO.Assets.Exports.UVirtualMaterialInstanceConstant));



var levelDocs=JsonDocument.Parse(File.ReadAllText(Path.Combine(root,"mesh-placement-plan","named-level-candidates.json")));
var levels=levelDocs.RootElement.EnumerateArray().Select(e=>e.GetProperty("path").GetString()!).Distinct(StringComparer.OrdinalIgnoreCase).ToArray();
Json("input-manifest.json",new{levels,count=levels.Length,source="DF level candidate packages only; Blender not placement source"});
int processed=0,parsed=0,failed=0,exports=0,components=0,ismComponents=0,instances=0;var watch=Stopwatch.StartNew();
Json("status.json",new{phase="metadata-extracting",pid=Environment.ProcessId,total=levels.Length,processed,parsed,failed,time=DateTime.UtcNow});
foreach(var path in levels){
 Check(true);used=Directory.EnumerateFiles(root,"*",SearchOption.AllDirectories).Sum(f=>new FileInfo(f).Length);
 try{
 var pkg=p.LoadPackage(path) as Package??throw new Exception("Package unavailable");
 int n=0,nc=0,ni=0;
 foreach(var lazy in pkg.ExportsLazy){
 Check();
 try{
 var obj=lazy.Value;n++;exports++;
 string id=path[..path.LastIndexOf('.')]+"/"+n.ToString("D6")+"-"+obj.Name;
 // Source JSON preserves actor/root refs, blueprint and custom streaming properties without flattening map variants.
 var source=Newtonsoft.Json.JsonConvert.SerializeObject(obj);
 Write(id+".source.json",System.Text.Encoding.UTF8.GetBytes(source));
 object? comp=null;
 if(obj is CUE4Parse.UE4.Assets.Exports.Component.USceneComponent c){
 components++;nc++;
 var chain=new List<object>();var seen=new HashSet<string>();var current=c;string? blocker=null;
 while(current!=null){
  var key=current.GetPathName();if(!seen.Add(key)){blocker="attachment cycle";break;}
  chain.Add(new{objectPath=key,translation=current.RelativeLocation,rotationEuler=current.RelativeRotation,rotationQuaternion=current.RelativeRotation.Quaternion(),scale=current.RelativeScale3D,attachParent=current.AttachParent?.ResolvedObject?.GetPathName(),template=current.Template?.GetPathName(),serializedPropertyNames=current.Properties.Select(x=>x.Name.Text).ToArray()});
  if(current.AttachParent==null||current.AttachParent.IsNull)break;
  try{current=current.AttachParent.Load<CUE4Parse.UE4.Assets.Exports.Component.USceneComponent>();if(current==null){blocker="unresolved attachment parent";break;}}catch(Exception ex){blocker=ex.Message;break;}
  if(chain.Count>128){blocker="attachment chain depth";break;}
 }
 object? sm=null;
 if(c is CUE4Parse.UE4.Assets.Exports.Component.StaticMesh.UStaticMeshComponent mc)sm=mc.GetOrDefault<CUE4Parse.UE4.Objects.UObject.FPackageIndex?>("StaticMesh")?.ResolvedObject?.GetPathName();
 object? inst=null;
 if(c is CUE4Parse.UE4.Assets.Exports.Component.StaticMesh.UInstancedStaticMeshComponent ic){
  ismComponents++;var data=ic.PerInstanceSMData;
  if(data!=null){
   ni+=data.Length;instances+=data.Length;
   var rawField=typeof(CUE4Parse.UE4.Assets.Exports.Component.StaticMesh.FInstancedStaticMeshInstanceData).GetField("Transform",BindingFlags.NonPublic|BindingFlags.Instance);
   inst=data.Select((d,i)=>new{index=i,transform=d.TransformData,rawMatrix=rawField?.GetValue(d),space="instance-local to component",worldVerified=false}).ToArray();
  }
 }
 comp=new{mesh=sm,chain,chainBlocker=blocker,instances=inst,worldVerified=false,status=blocker==null?"component-local/attachment-chain captured; runtime cell offset unresolved":"local-only unresolved hierarchy",absoluteFlags="see source serialized bAbsoluteLocation/Rotation/Scale; defaults not assumed",units="UE centimeters",originRouting="UNKNOWN CustomOpenWorldStreaming; not merged across candidate levels"};
 }
 Json(id+".metadata.json",new{package=path,name=obj.Name,objectPath=obj.GetPathName(),className=obj.ExportType,sourceJson=id+".source.json",component=comp,worldVerified=false});
 Append("exports.jsonl",new{package=path,objectPath=obj.GetPathName(),className=obj.ExportType,metadata=id+".metadata.json",worldVerified=false});
 }catch(OperationCanceledException){throw;}catch(Exception ex){Append("export-failures.jsonl",new{package=path,exportIndex=n,error=ex.ToString()});}
 }
 parsed++;Append("levels.jsonl",new{package=path,exports=n,components=nc,instances=ni,archive=(p.Files[path] as CUE4Parse.UE4.VirtualFileSystem.VfsEntry)?.Vfs.Path,worldVerified=false,mapVariantMerged=false});
 }catch(OperationCanceledException){throw;}catch(Exception ex){failed++;Append("failures.jsonl",new{package=path,error=ex.ToString()});}
 processed++;
 Json("status.json",new{phase="metadata-extracting",pid=Environment.ProcessId,total=levels.Length,processed,parsed,failed,exports,components,ismComponents,instances,elapsedSeconds=watch.Elapsed.TotalSeconds,time=DateTime.UtcNow});
 if(processed%10==0)GC.Collect();
}
Json("completed.json",new{total=levels.Length,processed,parsed,failed,exports,components,ismComponents,instances,verifiedWorldTransforms=0,coordinateValidation="NOT ESTABLISHED; Safe7 and multiple non-collinear anchors need DF instance identity and runtime offsets",elapsedSeconds=watch.Elapsed.TotalSeconds,time=DateTime.UtcNow});
record Entry(string path,string pak,long size);
