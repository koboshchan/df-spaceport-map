assert hist['placement']['objectPath']==obj
h=json.loads((O/'exact-nine-authentic-historical-records.json').read_text());contacts=h['historicalContactRecords'];nine=[x['index']for x in contacts if x['semanticClass']=='asphalt_ground_contact_candidate'and x['diagnosticFlags']['penetrationOver1CS']]
