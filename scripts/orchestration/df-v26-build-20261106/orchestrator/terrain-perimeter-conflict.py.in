def mesh(p):
 v=[];f=[]
 for l in Path(p).read_text().splitlines():
  s=l.split()
  if s and s[0]=='v':v.append(list(map(float,s[1:4])))
  elif s and s[0]=='f':f.append([int(x)-1 for x in s[1:]])
 return np.array(v),np.array(f)
m=json.loads((O/'approved-nine-mapping.json').read_text())['objects'];roads=[];planes=[];ids=[]
for a in m:
 d=np.load(a['triangleNPZ'])
 for t in d['vertices'][d['triangles']]:
  p=set_precision(Polygon(t[:,:2]),1e-7)
  if p.area<1e-8:continue
  roads.append(p);planes.append(np.linalg.solve(np.c_[t[:,:2],np.ones(3)],t[:,2]));ids.append(a['historicalIndex'])
foot=unary_union(roads);boundary=foot.boundary;tree=STRtree(roads);pts={i:{}for i in ids}
rows=json.loads((P/'seam-v4/next-build/integration-manifest.json').read_text())['artifacts']
def lines(g):
 if g.is_empty:return[]
 if g.geom_type in['LineString','LinearRing']:return[g]
 return[x for gg in getattr(g,'geoms',[])for x in lines(gg)]
for a in rows:
 if a['kind']!='CDLOD-derived':continue
 v,f=mesh(a['sourceOBJ']);lo=v[:,:2].min(axis=0);hi=v[:,:2].max(axis=0)
 if hi[0]<foot.bounds[0]or hi[1]<foot.bounds[1]or lo[0]>foot.bounds[2]or lo[1]>foot.bounds[3]:continue
 for t in v[f]:
