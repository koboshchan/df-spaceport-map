size,ver,rv,off,count=struct.unpack_from('<IHHII',b,0);blocks=[]
for i in range(count):
 pos=8+off+i*12;tag,rel,n=struct.unpack_from('<4sII',b,pos);start=pos+4+rel
 blocks.append(dict(tag=tag.decode('ascii'),offset=start,size=n,sha256=hashlib.sha256(b[start:start+n]).hexdigest(),first16Hex=b[start:start+16].hex()))
