   expected=roof['newParentSHA256']
  assert sha(Path(r['destination']))==expected
 # Every referenced entity and mesh descendant has one owner; graphs preserve complete unchanged blocks.
 direct=set(originalchildren);assert all(u in merged for u in direct)
 save('runner.json',dict(pid=os.getpid(),phase='PLACEMENT_INVENTORY',noInstall=True))
 placement=[u for u in originalchildren if merged[u][0]=='CMapMesh' or (merged[u][0]=='CMapEntity'and field(merged[field(merged[u][1],'entity_properties')][1],'classname') in ['prop_static','prop_dynamic','prop_dynamic_override'])]
 placementset=set(placement)
 parentnodes=[u for u in originalchildren if u not in placementset]
 cache={}
 def modelweight(model):
  if not model:return 0
  if model not in cache:
   p=B/'game/kat'/(model+'_c')
   with p.open('rb')as f:
    h=f.read(16);off,n=struct.unpack_from('<II',h,8);f.seek(8+off);tab=f.read(n*12)
   z=next((struct.unpack_from('<I',tab,i*12+8)[0]for i in range(n)if tab[i*12:i*12+4]==b'PHYS'),0)
   cache[model]=max(0,z-1700)
  return cache[model]
 def meshdata(u):
  b=merged[u][1];d=merged[field(b,'meshData')][1];a=merged[field(d,'vertexData')][1];ids=re.findall(r'"element" "([^"]+)"',a)
  stream=next(merged[x][1]for x in ids if field(merged[x][1],'semanticName')=='position')
  m=re.search(r'"data" "vector3_array"\s*\[(.*?)\]',stream,re.S);pts=[list(map(float,s.split()))for s in re.findall(r'"([^"]+)"',m[1])]
  assert pts
  # These baked mesh vertices use global frame; do not apply an invented extra transform.
  assert field(b,'origin')=='0 0 0'and field(b,'angles')=='0 0 0'and field(b,'scales')=='1 1 1'
  center=[sum(p[i]for p in pts)/len(pts)for i in range(3)]
  faces=re.search(r'"faceEdgeIndices" "int_array"\s*\[(.*?)\]',d,re.S);nf=len(re.findall(r'"-?\d+"',faces[1]))
  return center,len(pts)*12+nf*48+128
 save('runner.json',dict(pid=os.getpid(),phase='PHYS_WEIGHT_INVENTORY',noInstall=True))
 rows=[]
 for u in placement:
  k,b=merged[u];model=None
  if k=='CMapEntity':
   pb=merged[field(b,'entity_properties')][1];model=field(pb,'model');origin=list(map(float,field(b,'origin').split()));w=modelweight(model)
  else:origin,w=meshdata(u)
  rows.append(dict(uuid=u,type=k,model=model,origin=origin,weight=w,entitySHA256=hashlib.sha256(b.encode()).hexdigest()))
 save('runner.json',dict(pid=os.getpid(),phase='PARTITION_SWEEP',noInstall=True))
 total=sum(r['weight']for r in rows);assert total>0
 sweeps=[]
 for axis in [0,1]:
  ordered=sorted(rows,key=lambda r:(r['origin'][axis],r['uuid']));acc=0;best=None
  for i,r in enumerate(ordered[:-1]):
   acc+=r['weight']
   if r['origin'][axis]==ordered[i+1]['origin'][axis]:continue
   candidate=(abs(acc-total/2),i,acc,(r['origin'][axis]+ordered[i+1]['origin'][axis])/2)
   if best is None or candidate<best:best=candidate
  sweeps.append((best[0],axis,best[3],best[2],total-best[2]))
 _,axis,plane,w0,w1=min(sweeps)
 assignments={r['uuid']:int(r['origin'][axis]>=plane)for r in rows}
 for r in rows:r['newPart']='df_spaceport_v268_twopart_part'+str(assignments[r['uuid']])
 # Parent loaders are re-used from proven baseline with exactly two selected children and two output connections.
 extras={};loadernodes=[];parentblocks=parsed[0]
 for u,(k,b)in parentblocks.items():
  if k!='CMapEntity':continue
  pr=field(b,'entity_properties');pb=parentblocks[pr][1];cl=field(pb,'classname')
  if cl=='info_spawngroup_load_unload'and field(pb,'targetname')in ['df_v25_child0','df_v25_child1']:
   i=int(field(pb,'targetname')[-1]);extras[u]=(k,b.replace('df_v25_child', 'df_v268_twopart_child'));extras[pr]=(parentblocks[pr][0],pb.replace('df_spaceport_v267_part'+str(i),'df_spaceport_v268_twopart_part'+str(i)).replace('df_v25_child','df_v268_twopart_child'));loadernodes.append(u)
  if field(pb,'targetname')=='df_v25_load_children':
   conns=re.findall(r'"element" "([^"]+)"',re.search(r'"connectionsData" "element_array"\s*\[(.*?)\]',b,re.S)[1])[:2]
   extras[u]=(k,arr(b,'connectionsData',conns).replace('df_v25_load_children','df_v268_twopart_load_children'));extras[pr]=(parentblocks[pr][0],pb.replace('df_v25_load_children','df_v268_twopart_load_children'));loadernodes.append(u)
   for c in conns:extras[c]=(parentblocks[c][0],parentblocks[c][1].replace('df_v25_child','df_v268_twopart_child'))
 assert len(loadernodes)==3
 # Follow DMX element references rather than raw classname literals.
 def closure(blocks,roots):
  seen=set();todo=list(roots)
  while todo:
   u=todo.pop()
   if not u or u in seen:continue
   assert u in blocks,('missing ref',u)
   seen.add(u)
   for pair in refs(blocks[u][1]):
    x=pair[0]or pair[1]
    if x:todo.append(x)
  return seen
 # Only use canonical parent root/skeleton, whose world UUID is common to all baseline chunks.
 root=next(u for u,(k,b)in parsed[0].items()if k=='CMapRootElement')
 assert field(merged[root][1],'world')==worldid
 allblocks=dict(merged);allblocks.update(extras)
 # Determine graph-unreachable auxiliaries once. Preserve all orphan property records in parent, never treat as entities.
 save('runner.json',dict(pid=os.getpid(),phase='GRAPH_SCOPE',noInstall=True))
 originalreachable=closure(merged,[root])
 orphanaux=[u for u in merged if u not in originalreachable and merged[u][0]not in ['CMapRootElement','CMapWorld']]
 save('unreachable-records-preserved.json',dict(rows=[dict(uuid=u,type=merged[u][0],classname=field(merged[field(merged[u][1],'entity_properties')][1],'classname')if merged[u][0]=='CMapEntity'else None)for u in orphanaux],policy='Preserved byte-exact as unreferenced records in parent; never activated as world children.'))
 stageproof=[]
 alluuid=[]
 for ix,name in [(-1,'df_spaceport_v268_twopart'),(0,'df_spaceport_v268_twopart_part0'),(1,'df_spaceport_v268_twopart_part1')]:
  chosen=parentnodes+loadernodes if ix<0 else [u for u in placement if assignments[u]==ix]
  blocks=dict(allblocks);k,w=blocks[worldid];blocks[worldid]=(k,arr(w,'children',chosen))
  keep=closure(blocks,[root])
  if ix<0:keep.update(closure(blocks,orphanaux))
  selected={u:blocks[u]for u in blocks if u in keep}
