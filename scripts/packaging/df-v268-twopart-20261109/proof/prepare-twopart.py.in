  cls=collections.Counter(field(selected[field(b,'entity_properties')][1],'classname')for k,b in selected.values()if k=='CMapEntity')
  if ix<0:assert cls['trigger_hurt']==1847 and cls['info_player_terrorist']==16 and cls['info_player_counterterrorist']==16 and cls['info_spawngroup_load_unload']==2
  else:assert not cls['trigger_hurt']and not cls['info_player_terrorist']and not cls['env_sky']
  assert not cls['prop_dynamic']
  for u,(k,b)in selected.items():
   if k in ['CMapEntity','CMapMesh']and u not in loadernodes:alluuid.append(u);assert merged[u][1]==b
  text='<!-- dmx encoding keyvalues2 4 format vmap 40 -->\n\n'+'\n\n'.join(b for k,b in selected.values())+'\n'
