import bpy,json,pathlib,os,hashlib,math,time
from mathutils import Vector
P=pathlib.Path('@@DF_PATH_DF_EXTRACT_20261105@@')
R=P/'loot-skeletal/renders'
R.mkdir(exist_ok=True)
models=json.loads((P/'loot-skeletal/final-export-bake-report.json').read_text())['models']
eff=json.loads((P/'material-coverage/effective-material-parameters.json').read_text(encoding='utf-8'))
tex={}
for line in (P/'spacecenter-superset/textures.jsonl').read_text(encoding='utf-8').splitlines():
 t=json.loads(line)
 if t.get('ok') and t.get('target'): tex[t['path'].rsplit('.',1)[0].lower()]=str(P/'spacecenter-superset'/t['target'])
bpy.ops.wm.read_factory_settings(use_empty=True)
prefs=bpy.context.preferences.addons['cycles'].preferences
prefs.compute_device_type='OPTIX'
prefs.get_devices()
for d in prefs.devices: d.use=d.type=='OPTIX' and '4070' in d.name
devices=[{'name':d.name,'type':d.type,'use':bool(d.use)} for d in prefs.devices]
assert any(d['use'] for d in devices),devices
scene=bpy.context.scene
scene.render.engine='CYCLES'
scene.cycles.device='GPU'
scene.cycles.samples=32
scene.cycles.use_adaptive_sampling=False
scene.cycles.use_denoising=True
scene.cycles.denoiser='OPTIX'
scene.render.resolution_x=500
scene.render.resolution_y=440
scene.render.resolution_percentage=100
scene.render.image_settings.file_format='PNG'
scene.world=bpy.data.worlds.new('Neutral studio')
scene.world.use_nodes=True
scene.world.node_tree.nodes['Background'].inputs[0].default_value=(.24,.24,.24,1)
scene.world.node_tree.nodes['Background'].inputs[1].default_value=.65
scene.view_settings.view_transform='Standard'
scene.view_settings.look='Medium High Contrast' if False else 'None'
bpy.ops.object.camera_add(location=(3,-5,3.1))
cam=bpy.context.object
cam.data.type='ORTHO'
cam.data.ortho_scale=3.4
scene.camera=cam
target=Vector((0,0,.9))
cam.rotation_euler=(target-cam.location).to_track_quat('-Z','Y').to_euler()
def area(name,loc,power,size):
 bpy.ops.object.light_add(type='AREA',location=loc)
 o=bpy.context.object;o.name=name;o.data.energy=power;o.data.shape='DISK';o.data.size=size
 o.rotation_euler=(Vector((0,0,.8))-o.location).to_track_quat('-Z','Y').to_euler()
area('Key',(2,-3,5),450,4)
area('Fill',(-3,-1,3),250,4)
area('Rim',(1,3,4),350,3)
bpy.ops.mesh.primitive_plane_add(size=200)
floor=bpy.context.object
mat=bpy.data.materials.new('Studio floor');mat.diffuse_color=(.18,.2,.23,1);mat.use_nodes=True
mat.node_tree.nodes.get('Principled BSDF').inputs['Base Color'].default_value=(.18,.2,.23,1)
mat.node_tree.nodes.get('Principled BSDF').inputs['Roughness'].default_value=.85
floor.data.materials.append(mat)
receipt={'pid':os.getpid(),'engine':'CYCLES','device':'GPU','backend':'OPTIX','samples':32,'devices':devices,'started':time.time(),'tiles':[],'shaderStatus':'basecolor preview; packed channels, layer blends, transparency and complete UE graph unvalidated','closedPose':'UNPROVEN original static-baked outputs'}
def save():
 (R/'manifest.json').write_text(json.dumps(receipt,indent=2))
save()
for i,m in enumerate(models):
 before=set(bpy.data.objects)
 bpy.ops.import_scene.gltf(filepath=m['output'])
 objects=[o for o in bpy.data.objects if o not in before]
 meshes=[o for o in objects if o.type=='MESH']
 assert meshes
 meta=json.loads(pathlib.Path(m['source']).with_suffix('.metadata.json').read_text(encoding='utf-8'))
 # Imported glTF Y-up converted by Blender importer to Z-up. Apply normalization via root only.
 coords=[o.matrix_world@Vector(c) for o in meshes for c in o.bound_box]
 lo=Vector(tuple(min(v[a] for v in coords) for a in range(3)))
 hi=Vector(tuple(max(v[a] for v in coords) for a in range(3)))
 scale=1.8/max(hi-lo)
 center=Vector(((lo.x+hi.x)/2,(lo.y+hi.y)/2,lo.z))
 for o in objects:
  if o.parent is None:
   o.location=(o.location-center)*scale
   o.scale*=scale
 bpy.context.view_layer.update()
 bindings=[]
 for slot in meta['slots']:
  idx=slot['index'];mi=slot['material'];e=eff.get(mi,{})
  params=[p for p in e.get('effective_parameters',[]) if p['kind']=='TextureParameterValues']
  bc=[p for p in params if p['parameter_info']['Name'].lower()=='basecolormap']
  # layered materials cannot be faithfully collapsed to a chosen layer
  path=None
  if bc:
   key=bc[0]['value']['ObjectPath'].rsplit('.',1)[0].lower()
   path=tex.get(key)
  binding={'slot':idx,'MI':mi,'basecolor':path,'status':'basecolor' if path and pathlib.Path(path).exists() else 'UNKNOWN layered/no direct basecolor'}
  bindings.append(binding)
  mat=bpy.data.materials.new('DF_'+str(i)+'_'+str(idx));mat.use_nodes=True
  bs=mat.node_tree.nodes.get('Principled BSDF')
  bs.inputs['Roughness'].default_value=.65
  bs.inputs['Metallic'].default_value=0
  bs.inputs['Base Color'].default_value=(.32,.32,.32,1)
  if path and pathlib.Path(path).exists():
   image=bpy.data.images.load(path,check_existing=True)
   image.colorspace_settings.name='sRGB'
   node=mat.node_tree.nodes.new('ShaderNodeTexImage');node.image=image
   mat.node_tree.links.new(node.outputs['Color'],bs.inputs['Base Color'])
  # glTF material names preserve exporter slot identity, duplicate source slots may collapse
  source_name=mi.split('.')[-1].lower()
  for o in meshes:
   for s in o.material_slots:
    if s.material and s.material.name.split('.')[0].lower()==source_name:
     s.material=mat
 tile=R/('tile-%02d.png'%i)
 scene.render.filepath=str(tile)
 scene.cycles.samples=32
 assert scene.cycles.device=='GPU' and scene.cycles.samples==32
 bpy.ops.render.render(write_still=True)
 receipt['tiles'].append({'index':i,'name':pathlib.Path(m['output']).stem,'source':m['output'],'sourceSHA256':hashlib.sha256(pathlib.Path(m['output']).read_bytes()).hexdigest(),'tile':str(tile),'engine':'CYCLES','device':'GPU','samples':32,'bindings':bindings,'meshObjects':len(meshes)})
 save()
 for o in objects: bpy.data.objects.remove(o,do_unlink=True)
 for im in list(bpy.data.images):
  if im.users==0: bpy.data.images.remove(im)
receipt['renderComplete']=time.time()
save()
