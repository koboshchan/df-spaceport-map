import bpy,json,pathlib,os,hashlib,math,time,shutil
from mathutils import Vector
P=pathlib.Path('@@DF_PATH_DF_EXTRACT_20261105@@')
D=P/'loot-skeletal/states-priority-03909539'
R=D/'renders-mid-idle-v1';R.mkdir(exist_ok=True)
statepath=D/'selected-mid-idle-v1/current-state-manifest.json'
manifest=json.loads(statepath.read_text());tiles=manifest['tiles']
models=json.loads((P/'loot-skeletal/final-export-bake-report.json').read_text())['models']
eff=json.loads((P/'material-coverage/effective-material-parameters.json').read_text(encoding='utf-8'))
tex={}
for line in (P/'spacecenter-superset/textures.jsonl').read_text(encoding='utf-8').splitlines():
 t=json.loads(line)
 if t.get('ok') and t.get('target'):tex[t['path'].rsplit('.',1)[0].lower()]=str(P/'spacecenter-superset'/t['target'])
receipt={'pid':os.getpid(),'engine':'CYCLES','device':'GPU','backend':'OPTIX','samples':32,'started':time.time(),'tiles':[],'sourceManifest':str(statepath),'sourceManifestSHA256':hashlib.sha256(statepath.read_bytes()).hexdigest(),'orientation':'Source canonical basis preserved. One common union-bound uniform scale+translation per model for preview only. No rotations; actual geometry remains untouched.','shaderStatus':'Existing approved DF direct basecolor textures only, full UE layered packed-channel shader unvalidated.'}
def save():(R/'manifest.json').write_text(json.dumps(receipt,indent=2))
for id in ['548','660','557']:
 group=[x for x in tiles if x['id']==id]
 bpy.ops.wm.read_factory_settings(use_empty=True)
 prefs=bpy.context.preferences.addons['cycles'].preferences;prefs.compute_device_type='OPTIX';prefs.get_devices()
 for d in prefs.devices:d.use=d.type=='OPTIX' and '4070' in d.name
 devices=[{'name':d.name,'type':d.type,'use':bool(d.use)} for d in prefs.devices]
 assert any(d['use'] for d in devices),devices
 receipt['devices']=devices;save()
 scene=bpy.context.scene;scene.render.engine='CYCLES';scene.cycles.device='GPU';scene.cycles.samples=32
 scene.cycles.use_adaptive_sampling=False;scene.cycles.use_denoising=True;scene.cycles.denoiser='OPTIX'
 scene.render.resolution_x=640;scene.render.resolution_y=520;scene.render.resolution_percentage=100;scene.render.image_settings.file_format='PNG'
 scene.world=bpy.data.worlds.new('Neutral studio');scene.world.use_nodes=True
 scene.world.node_tree.nodes['Background'].inputs[0].default_value=(.24,.24,.24,1);scene.world.node_tree.nodes['Background'].inputs[1].default_value=.65
 scene.view_settings.view_transform='Standard';scene.view_settings.look='None'
 bpy.ops.object.camera_add(location=(3,-5,3.1));cam=bpy.context.object;cam.data.type='ORTHO';cam.data.ortho_scale=3.1;scene.camera=cam
 target=Vector((0,0,.9));cam.rotation_euler=(target-cam.location).to_track_quat('-Z','Y').to_euler()
 def area(name,loc,power,size):
  bpy.ops.object.light_add(type='AREA',location=loc);o=bpy.context.object;o.name=name;o.data.energy=power;o.data.shape='DISK';o.data.size=size
  o.rotation_euler=(Vector((0,0,.8))-o.location).to_track_quat('-Z','Y').to_euler()
 area('Key',(2,-3,5),450,4);area('Fill',(-3,-1,3),250,4);area('Rim',(1,3,4),350,3)
 bpy.ops.mesh.primitive_plane_add(size=200);floor=bpy.context.object
 mat=bpy.data.materials.new('Studio floor');mat.use_nodes=True;bs=mat.node_tree.nodes.get('Principled BSDF');bs.inputs['Base Color'].default_value=(.18,.2,.23,1);bs.inputs['Roughness'].default_value=.85;floor.data.materials.append(mat)
 allcoords=[];variants=[]
 model=next(m for m in models if pathlib.Path(m['output']).stem==group[0]['canonical'])
 meta=json.loads(pathlib.Path(model['source']).with_suffix('.metadata.json').read_text(encoding='utf-8'))
 for t in group:
  assert hashlib.sha256(pathlib.Path(t['file']).read_bytes()).hexdigest()==t['sha256']
  before=set(bpy.data.objects);bpy.ops.import_scene.gltf(filepath=t['file']);objects=[o for o in bpy.data.objects if o not in before];meshes=[o for o in objects if o.type=='MESH'];assert meshes
  allcoords.extend(o.matrix_world@Vector(c) for o in meshes for c in o.bound_box)
  variants.append((t,objects,meshes))
 lo=Vector(tuple(min(v[a] for v in allcoords) for a in range(3)));hi=Vector(tuple(max(v[a] for v in allcoords) for a in range(3)))
 scale=1.8/max(hi-lo);center=Vector(((lo.x+hi.x)/2,(lo.y+hi.y)/2,lo.z))
 bindings=[];seen=set()
 for slot in meta['slots']:
  idx=slot['index'];mi=slot['material'];e=eff.get(mi,{})
  if mi in seen:continue
  seen.add(mi)
  params=[p for p in e.get('effective_parameters',[]) if p['kind']=='TextureParameterValues']
  bc=[p for p in params if p['parameter_info']['Name'].lower()=='basecolormap'];path=None
  if bc:path=tex.get(bc[0]['value']['ObjectPath'].rsplit('.',1)[0].lower())
  if path:
   dst=R/('texture-'+hashlib.sha256(path.encode()).hexdigest()[:16]+'.png')
   shutil.copyfile('\\\\?\\'+str(pathlib.Path(path).absolute()),str(dst));path=str(dst)
  assert path and pathlib.Path(path).exists(),(id,idx,mi,'Missing approved direct basecolor')
  mat=bpy.data.materials.new('DF_'+id+'_'+str(idx));mat.use_nodes=True;bs=mat.node_tree.nodes.get('Principled BSDF')
  bs.inputs['Roughness'].default_value=.65;bs.inputs['Metallic'].default_value=0
  image=bpy.data.images.load(path,check_existing=True);image.colorspace_settings.name='sRGB'
  node=mat.node_tree.nodes.new('ShaderNodeTexImage');node.image=image;mat.node_tree.links.new(node.outputs['Color'],bs.inputs['Base Color'])
  source_name=mi.split('.')[-1].lower();assigned=0
  print('MATNAMES',source_name,[[s.material.name if s.material else None for s in o.material_slots] for t,objects,meshes in variants for o in meshes],flush=True)
  for t,objects,meshes in variants:
   for o in meshes:
    for s in o.material_slots:
     if s.material and s.material.name.split('.')[0].lower()==source_name:s.material=mat;assigned+=1
  assert assigned>0,(id,mi)
  bindings.append({'slot':idx,'MI':mi,'basecolor':path,'assigned':assigned})
 for t,objects,meshes in variants:
  for o in objects:
   if o.parent is None:o.location=(o.location-center)*scale;o.scale*=scale
   o.hide_render=True
 bpy.context.view_layer.update()
 for t,objects,meshes in variants:
  for o in objects:o.hide_render=False
  tile=R/(id+'-'+t['state']+'.png');scene.render.filepath=str(tile)
  assert scene.cycles.samples==32 and scene.cycles.device=='GPU'
  bpy.ops.render.render(write_still=True)
  receipt['tiles'].append(dict(t,tile=str(tile),engine='CYCLES',device='GPU',samples=32,bindings=bindings,unionBounds=[list(lo),list(hi)],sharedScale=scale,sharedTranslation=list(center),cameraMatrix=[list(r) for r in cam.matrix_world],orthoScale=cam.data.ortho_scale))
  save()
  for o in objects:o.hide_render=True
receipt['renderComplete']=time.time();save()
print('PRIORITY_NINE_TILES_RENDER_COMPLETE',json.dumps(receipt['devices']))
