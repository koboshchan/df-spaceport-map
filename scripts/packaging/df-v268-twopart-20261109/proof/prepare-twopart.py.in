 save('UUID-partition-manifest.json',dict(sourceAncestry=sources,allPlacementRows=rows,allEntityAndMeshUUIDOwnershipCount=len(alluuid),exactlyOnce=True,allNodeBlocksExact=True,noDynamicConversions=True,originalDynamics=classes['prop_dynamic'],validatedAggGeomModels=333,validatedAggGeomPlacements=15191,orphanPropertiesPreservedParent=True))
 projected=[753782938*w0/total,753782938*w1/total]
