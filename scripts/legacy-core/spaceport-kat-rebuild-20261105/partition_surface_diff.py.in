
from pathlib import Path
import json,numpy as np,trimesh
W=Path('@@DF_PATH_SPACEPORT_KAT_REBUILD_20261105@@');O=W/'partition-full'
d=np.load(O/'topology-diff-child0.npz');verts=d['vertices'];mt=d['missing'];et=d['extra']
nd=(mt[:,0]!=mt[:,1])&(mt[:,0]!=mt[:,2])&(mt[:,1]!=mt[:,2]);mt=mt[nd]
def mesh(ts):return trimesh.Trimesh(vertices=verts,faces=ts,process=False,validate=False)
mm,em=mesh(mt),mesh(et)
weights=np.array([[1,0,0],[0,1,0],[0,0,1],[.5,.5,0],[.5,0,.5],[0,.5,.5],[1/3,1/3,1/3],[.6,.2,.2],[.2,.6,.2],[.2,.2,.6]])
out=[]
for name,source,target in [('expected_to_actual',mm,em),('actual_to_expected',em,mm)]:
 points=np.einsum('kj,njd->nkd',weights,source.triangles).reshape(-1,3);all_d=[];all_c=[]
 for j in range(0,len(points),5000):
  nearest,dist,face=trimesh.proximity.closest_point(target,points[j:j+5000]);all_d.extend(dist);all_c.extend(nearest)
 dd=np.asarray(all_d);ii=int(dd.argmax());areas=source.area_faces
 per=dd.reshape(-1,len(weights)).max(axis=1)
 out.append(dict(direction=name,points=len(points),distance_percentiles=np.percentile(dd,[0,50,90,95,99,99.9,100]).tolist(),maximum_location=points[ii].tolist(),maximum_nearest=np.asarray(all_c)[ii].tolist(),surface_area_total=float(areas.sum()),surface_area_faces_over_0062=float(areas[per>.0062].sum()),surface_area_faces_over_01=float(areas[per>.1].sum()),surface_area_faces_over_1=float(areas[per>1].sum()),scope='unmatched nondegenerate face union only, mapped compiled vertex coordinates; sampled ten points per face not rigorous Hausdorff bound'))
(O/'triangle-diff-surface-sampled.json').write_text(json.dumps(out,indent=2))
