collision=packet['collisionSidecar']['record']
frame=Path('@@DF_PATH_DF_EXTRACT_20261105@@/placements/validation/static-anchor-source-proof.json');f=json.loads(frame.read_text())
out=dict(status='HOLD_READONLY_BOUNDED_SOURCE_INSPECTION',parentPacketSHA256=sha(O/'road12-readonly-decision-packet.json'),qualificationSHA256=sha(O/'road12-support-material-qualification.json'),intentJoin=dict(historicalIndex=12,selectionPath=str(s),selectionSHA256=sha(s),selectionRecord=hist,objectPathExact=True,meshObjectPathExact=True,matrixExact=True,historicalNineIndices=[x['historicalIndex']for x in mapping['objects']],contactRecord=next(x for x in contacts if x['index']==12),authorizationWitness='Exact user message 2026-11-06T12:11:19-07:00 explicitly approves the9asphaltplacements; same indices1,5,12,23,44,49,52,79,82 in caller kickoff. This is a selection/contact-record intent join, NOT user-mark UUID join.',limits='Nine selection membership proven from immutable historical records and supplied exact-index scope. Semantic contact flag remains MEASURED_NOT_CONTACT_CERTIFIED, not collision evidence. No UUID invented.'),cachedPlacement=dict(path=str(p),sha256=sha(p),record=r,comparison='Exact objectPath/mesh/matrix match to historical index12; source-frame consistency, not independent landmark verification'),compiledModel=dict(path=str(c),sha256=sha(c),bytes=len(b),declaredFileSize=size,headerVersion=ver,resourceVersion=rv,blocks=blocks,interpretation='Existing PHYS block presence/hash only. No decoder or native executable invoked. Serialized collision hull/triangles/filters and support not decoded or certified.'),modelSource=dict(path=str(v),sha256=sha(v),text=v.read_text(),interpretation='PhysicsMeshFromRender is conversion policy, not DF custom-body equivalence or runtime proof.'),sourceCollision=dict(bodySetup=collision,componentBodyInstance=body.get('BodyInstance'),customPhysicsCreating=body.get('bCustomizedPhysicsCreating'),tags=body.get('ComponentTags'),missing='No referenced custom cooked-body payload or runtime resolver serialized in this component JSON. BodySetup policy alone is overridden; existing native PHYS is generated from render source, not independent DF-support evidence.'),landmark=dict(path=str(frame),sha256=sha(frame),status=f.get('status'),residualRMSCS2=f.get('residualRMSCS2'),exactTargetMentioned=obj in json.dumps(f)or pl['meshObjectPath']in json.dumps(f),limits='Cached global anchor fit supports general coordinate frame; it contains no exact road12/component witness. Not a direct local support/placement measurement.'),missingWitnessBeforeUserDecision='Need decoded collision geometry/filter and instance pose for this exact customized DF component, or an already-cached exact-component native-PHYS+map-world placement/hull witness establishing its actual support at the road12 perimeter. Current generated PhysicsMeshFromRender and global landmark fit do not supply that. Do not ask for outside-blend choice.',preservation='No edits to fine168, other roads, source geometry, compiled assets or runtime. No native/compiler/live queries; no outside-buffer implementation.')
q=O/'road12-bounded-source-support-identity.json';q.open('x').write(json.dumps(out,indent=2));print(json.dumps(dict(path=str(q),sha256=sha(q),nativeBlocks=blocks,exactIntentJoin=True,exactCachedPose=True,localLandmark=False),indent=2))
