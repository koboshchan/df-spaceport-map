def sha(p):
 with p.open('rb') as f:return hashlib.file_digest(f,'sha256').hexdigest()
def save(n,j):(Q/n).write_text(json.dumps(j,indent=2))
def field(b,k):
 m=re.search('"'+re.escape(k)+'" "[^"]+" "([^"]*)"',b);return m.group(1) if m else None
def refs(b):return re.findall(r'"(?:[^"]+)" "element" "([^"]+)"|"element" "([^"]+)"',b)
def children(b):
 m=re.search(r'"children" "element_array"\s*\[(.*?)\]',b,re.S);return re.findall(r'"element" "([^"]+)"',m[1]) if m else []
def arr(b,key,ids):return re.sub(r'("'+key+r'" "element_array"\s*\[).*?(\])',lambda m:m[1]+'\n'+',\n'.join('\t\t"element" "'+u+'"'for u in ids)+'\n\t'+m[2],b,count=1,flags=re.S)
