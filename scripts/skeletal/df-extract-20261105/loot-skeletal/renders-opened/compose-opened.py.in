import pathlib,json,hashlib
from PIL import Image,ImageDraw,ImageFont,ImageStat
r=pathlib.Path('@@DF_PATH_DF_EXTRACT_20261105@@/loot-skeletal/renders-opened')
d=json.loads((r/'manifest.json').read_text())
assert d.get('renderComplete') and len(d['tiles'])==27
sheet=Image.new('RGB',(3000,2500),(39,43,49));draw=ImageDraw.Draw(sheet)
fontpath='@@DF_PATH_WINDOWS@@/Fonts/consola.ttf'
for t in d['tiles']:
 i=t['index'];x=i%6*500;y=i//6*500
 if t['state']=='OPENED':
  im=Image.open(t['tile']).convert('RGB');sheet.paste(im,(x,y))
  stat=ImageStat.Stat(im.crop((80,70,420,360)));assert max(stat.stddev)>3
  t['imageStddev']=stat.stddev;t['imageSHA256']=hashlib.sha256(pathlib.Path(t['tile']).read_bytes()).hexdigest()
 else:
  draw.rounded_rectangle((x+20,y+65,x+480,y+375),radius=12,fill=(53,57,65),outline=(235,176,85),width=2)
  draw.text((x+145,y+170),'UNRESOLVED',font=ImageFont.truetype(fontpath,30),fill=(255,200,100))
  draw.text((x+70,y+225),'No verified opened geometry',font=ImageFont.truetype(fontpath,20),fill=(235,235,240))
 size=18
 while True:
  font=ImageFont.truetype(fontpath,size)
  if draw.textlength(t['name'],font=font)<480 or size<=11:break
  size-=1
 draw.text((x+(500-draw.textlength(t['name'],font=font))/2,y+442),t['name'],font=font,fill=(238,240,244))
 status='OPENED | canonical basis' if t['state']=='OPENED' else 'UNRESOLVED | state not certified'
 if any(b['status'].startswith('UNKNOWN') for b in t['bindings']):status='OPENED | material shader UNRESOLVED'
 draw.text((x+12,y+475),status,font=ImageFont.truetype(fontpath,14),fill=(255,200,100) if 'UNRESOLVED' in status else (170,220,190))
out=r/'df-loot-opened.png';sheet.save(out)
d['contactSheet']={'path':str(out),'dimensions':[3000,2500],'count':27,'opened':24,'unresolved':3,'bytes':out.stat().st_size,'sha256':hashlib.sha256(out.read_bytes()).hexdigest()}
d['materialProof']='@@DF_PATH_DF_EXTRACT_20261105@@/loot-skeletal/material-cloth-readiness/dumpster-material-binding-proof.json'
d['dumpsterShader']='UNRESOLVED cooked expression graph missing; no invented layered shader'
(r/'manifest.json').write_text(json.dumps(d,indent=2))
print(json.dumps(d['contactSheet']))
