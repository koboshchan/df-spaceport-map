import subprocess
M=json.loads((O/'integration-manifest.json').read_text());selected=[]
for approximate in [False,True]:
 choices=[r for r in M['artifacts'] if r['approximate']==approximate and (O/'game/kat'/(r['model']+'_c')).exists()]
 selected.append(max(choices,key=lambda r:r['triangles']))
out=[]
for row in selected:
 dst=O/'game/kat'/(row['model']+'_c');phys=O/(row['canonicalID']+'-pilot.physbin')
 subprocess.run(['dotnet','@@DF_PATH_SPACEPORT_KAT_REBUILD_20261105@@/partition-full/phys-reader/bin/Release/net10.0/Reader.dll',str(dst),str(phys)],check=True)
 source=readobj(P/'staged'/(row['canonicalID']+'.obj'));native=readphys(phys);d,idx=cKDTree(source.mean(axis=1)).query(native.mean(axis=1),k=1);cyclic=np.stack([np.max(np.linalg.norm(native-np.roll(source[idx],j,axis=1),axis=2),axis=1) for j in range(3)]).min(axis=0)
 ns=np.cross(source[idx,1]-source[idx,0],source[idx,2]-source[idx,0]);nn=np.cross(native[:,1]-native[:,0],native[:,2]-native[:,0]);norm=np.einsum('ij,ij->i',ns,nn)/(np.linalg.norm(ns,axis=1)*np.linalg.norm(nn,axis=1))
 r=dict(canonicalID=row['canonicalID'],approximate=row['approximate'],sourceTriangles=len(source),nativeTriangles=len(native),uniqueMatches=len(np.unique(idx)),maxVertexError=float(max(cyclic)),minNormalAgreement=float(min(norm)))
 r['pass']=len(source)==len(native)==r['uniqueMatches'] and r['maxVertexError']<.02 and r['minNormalAgreement']>.99999;out.append(r)
(O/'native-pilot-qa.json').write_text(json.dumps(dict(assets=out),indent=2));print(json.dumps(out,indent=2));assert all(r['pass']for r in out)
