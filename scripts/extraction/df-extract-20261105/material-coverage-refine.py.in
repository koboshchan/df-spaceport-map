ROOT=pathlib.Path(r'@@DF_PATH_DF_EXTRACT_20261105@@');O=ROOT/'material-coverage';S=ROOT/'spacecenter-superset'
def load(p):return json.loads(p.read_text(encoding='utf-8-sig'))
def save(n,x):(O/n).write_text(json.dumps(x,ensure_ascii=False,indent=2),encoding='utf-8')
def table(n,rows):
 if not rows:return
 with (O/n).open('w',newline='',encoding='utf-8-sig') as f:
  w=csv.DictWriter(f,fieldnames=list(rows[0]));w.writeheader()
  for r in rows:w.writerow({k:json.dumps(v,ensure_ascii=False) if isinstance(v,(dict,list)) else v for k,v in r.items()})
