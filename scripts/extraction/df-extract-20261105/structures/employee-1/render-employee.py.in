import bpy,json,pathlib,math,hashlib,time,os,copy
from mathutils import Matrix,Vector
from mathutils.bvhtree import BVHTree
R=pathlib.Path('@@DF_PATH_DF_EXTRACT_20261105@@');O=R/'structures/employee-1';O.mkdir(exist_ok=True)
MD=R/'placements/validation/resolution/metadata/objects'
PKG='DeltaForce/Content/Maps/SpaceCenter_Ma1/InterActors/Gameplay/Gameplay_x26_y18_0'
SRC=R/'placements'/PKG
BP='DeltaForce/Content/BluePrints/Interact/Door/BaseNew/BP_Interactor_SlideDoorBase'
def read(p):
 d=json.loads(p.read_text(encoding='utf-8-sig'));return d.get('source',d)
def loadref(ref):
 op=ref['ObjectPath'];pkg,i=op.rsplit('.',1);i=int(i)
 fs=list((R/'placements'/pkg).glob(f'{i+1:06d}-*.source.json'))
 p=fs[0] if fs else MD/pkg/f'{i:06d}.json'
 return read(p)
def merge(a,b):
 a=copy.deepcopy(a)
 for k,v in b.items():
  if isinstance(v,dict) and isinstance(a.get(k),dict):a[k]=merge(a[k],v)
  else:a[k]=copy.deepcopy(v)
 return a
def props(d,seen=()):
 ref=d.get('Template')
 return merge(props(loadref(ref),seen+(d['Name'],)) if ref and d['Name'] not in seen else {},d.get('Properties',{}))
actor=read(SRC/'000089-BP_Interactor_SlideDoor_7.source.json')
def obj(name):
 return loadref(actor['Properties'][name])
def trans(p):
 loc=p.get('RelativeLocation',{});rot=p.get('RelativeRotation',{});scale=p.get('RelativeScale3D',{})
 a=Matrix.Translation(Vector([loc.get(k,0)/100 for k in 'XYZ']))
 a=a@Matrix.Rotation(math.radians(rot.get('Yaw',0)),4,'Z')@Matrix.Rotation(-math.radians(rot.get('Pitch',0)),4,'Y')@Matrix.Rotation(-math.radians(rot.get('Roll',0)),4,'X')
 return a@Matrix.Diagonal(Vector([scale.get(k,1) for k in 'XYZ']+[1]))
root=props(obj('DefaultSceneRoot'));origin=Vector([root['RelativeLocation'][k]/100 for k in 'XYZ'])
def world(name,opened):
 d=obj(name);p=props(d)
 # inherited override Door7 is merged over parent DoorBase for collision defaults only;
 # source explicit vectors already complete.
 mat=trans(p)
 if name=='DoorProxy' and opened:
  ep=read(MD/'DeltaForce/Content/BluePrints/Interact/Door/BaseNew/BP_Interactor_SlideDoor_7/000012.json')['Properties']['OpenedLoc']
  mat=Matrix.Translation(Vector([ep[k]/100 for k in 'XYZ']))@mat
 par=p.get('AttachParent')
 if par:mat=world(par['ObjectName'].split('.')[-1].rstrip("'"),opened)@mat
 return mat
bpy.ops.wm.read_factory_settings(use_empty=True)
scene=bpy.context.scene
prefs=bpy.context.preferences.addons['cycles'].preferences;prefs.compute_device_type='OPTIX';prefs.get_devices()
for d in prefs.devices:d.use=d.type=='OPTIX' and '4070' in d.name
devices=[dict(name=d.name,type=d.type,use=bool(d.use)) for d in prefs.devices];assert any(d['use'] for d in devices)
receipt=dict(status='STARTED',engine='CYCLES',samples=32,backend='OPTIX',device='GPU',devices=devices,pid=os.getpid(),materialMode='NEUTRAL_CLAY_GEOMETRY_ONLY, not finished DF materials',materialBlocker='M_MatBlend_Structures_Master layered shader parity unresolved',actor=PKG+'.Gameplay_x26_y18_0:PersistentLevel.BP_Interactor_SlideDoor_7',openedLocUEcm=[0,0,-620],rootPositionUEcm=[root['RelativeLocation'][k] for k in 'XYZ'],objects=[],started=time.time())
def save(): (O/'render-receipt.json').write_text(json.dumps(receipt,indent=2),encoding='utf8')
save()
clay=bpy.data.materials.new('Neutral clay - pose verification only');clay.use_nodes=True
bs=clay.node_tree.nodes.get('Principled BSDF');bs.inputs['Base Color'].default_value=(.46,.49,.52,1);bs.inputs['Roughness'].default_value=.82
def imp(path,mat,name):
 assert path.exists(),path
 before=set(bpy.data.objects);bpy.ops.import_scene.gltf(filepath=str(path))
 objects=[o for o in bpy.data.objects if o not in before];meshes=[o for o in objects if o.type=='MESH']
 # Exporter is (UE.X,UE.Z,UE.Y) meters; Blender glTF import gives (UE.X,-UE.Y,UE.Z). Reflect local Y before UE component transform.
 for o in objects:
  if o.parent is None:o.matrix_world=mat@Matrix.Diagonal(Vector((1,-1,1,1)))@o.matrix_world
 for o in meshes:
  o.name=name+'_'+o.name;o.data.materials.clear();o.data.materials.append(clay)
  for f in o.data.polygons:f.material_index=0
 bpy.context.view_layer.update()
 pts=[o.matrix_world@v.co for o in meshes for v in o.data.vertices]
 lo=[min(v[i] for v in pts) for i in range(3)];hi=[max(v[i] for v in pts) for i in range(3)]
 receipt['objects'].append(dict(name=name,glb=str(path),sha256=hashlib.sha256(path.read_bytes()).hexdigest(),matrix=[list(r) for r in mat],boundsMeters=[lo,hi]))
 return meshes
parts={}
for name in ['Door','Door1','ForwardLock','BackwardLock']:
 p=props(obj(name));path=p['StaticMeshPath']['AssetPathName'].replace('/Game/','DeltaForce/Content/').rsplit('.',1)[0]+'.glb'
 m=world(name,True);m.translation-=origin
 parts[name]=imp(R/'meshes'/path,m,name)
# real adjacent source walls, no fabricated gate/frame or stage floor.
ctx=json.loads((O/'context-candidates.json').read_text(encoding='utf8'))
for x in ctx:
 if x['mesh'].endswith('SM_H_Fence_Metal_1024x768_01.SM_H_Fence_Metal_1024x768_01') and (math.dist(x['positionUEcm'][:2],[root['RelativeLocation'][k] for k in 'XY'])<700 or 'StaticMeshComponent14'==x['objectPath'].split('.')[-1]):
  mat=Matrix(x['matrixUEcm']);mat.translation=mat.translation/100-origin
  imp(R/'meshes'/(x['mesh'].rsplit('.',1)[0]+'.glb'),mat,'SourceAdjacentWall')
def bvh(objects):
 vs=[];fs=[]
 for o in objects:
  o.data.calc_loop_triangles();n=len(vs);vs += [o.matrix_world@v.co for v in o.data.vertices];fs += [tuple(n+i for i in t.vertices) for t in o.data.loop_triangles]
 return BVHTree.FromPolygons(vs,fs,all_triangles=True)
cap=bvh(parts['Door1']);slab=bvh(parts['Door'])
samples=[]
for x in [1.0,2.0,3.0,3.84,4.5,5.5,6.5]:
 for y in [-1.15,-.6,-.1, .4,1.0,1.8]:
  p,n,idx,dist=cap.ray_cast(Vector((x,y,5)),Vector((0,0,-1)),10)
  if p:
   q,qn,qi,qd=slab.ray_cast(Vector((x,y,5)),Vector((0,0,-1)),20)
   samples.append(dict(x=x,y=y,capZ=p.z,slabZ=q.z if q else None,slabBelowCap=q is None or q.z<=p.z+.003))
receipt['crossingSamples']=samples
receipt['clearanceStatus']='ALL_SAMPLED_CAP_POINTS_SLAB_FLUSH_OR_BELOW' if samples and all(s['slabBelowCap'] for s in samples) else 'BLOCKED_OR_UNPROVEN'
# swept horizontal centerline at 0.4,1.0,1.8m above cap level, excluding fixed source walls outside portal
cross=[]
for x in [1,2,3,3.84,4.5,5.5,6.5]:
 for z in [.74,1.34,2.14]:
  p,n,idx,dist=slab.ray_cast(Vector((x,-4,z)),Vector((0,1,0)),8)
  cross.append(dict(x=x,z=z,slabHit=p is not None))
receipt['slabCrossingRays']=cross
receipt['clearanceStatus']='OPEN_SLAB_TOP_0.330m_MAX; cap has center slot filled by lowered slab, not slab entirely below cap. Swept-ray checks recorded; runtime collision untested.';save()
assert not any(s['slabHit'] for s in cross)
receipt['nativeRuntimeCaveat']='Static endpoint composed through serialized DoorProxy parent; no DF runtime or Source2 collision playtest performed.'
scene.render.engine='CYCLES';scene.cycles.device='GPU';scene.cycles.samples=32;scene.cycles.use_adaptive_sampling=False;scene.cycles.use_denoising=True;scene.cycles.denoiser='OPTIX'
scene.render.resolution_x=1440;scene.render.resolution_y=900;scene.render.resolution_percentage=100;scene.render.image_settings.file_format='PNG'
scene.world=bpy.data.worlds.new('Neutral background');scene.world.use_nodes=True;scene.world.node_tree.nodes['Background'].inputs[0].default_value=(.16,.18,.21,1);scene.world.node_tree.nodes['Background'].inputs[1].default_value=.6
scene.view_settings.view_transform='AgX'
target=Vector((3.84,0,2.7));bpy.ops.object.camera_add(location=(5,-22,5.6));cam=bpy.context.object;cam.rotation_euler=(target-cam.location).to_track_quat('-Z','Y').to_euler();cam.data.type='ORTHO';cam.data.ortho_scale=11.7;scene.camera=cam
def area(loc,power,size):
 bpy.ops.object.light_add(type='AREA',location=loc);o=bpy.context.object;o.data.energy=power;o.data.shape='DISK';o.data.size=size;o.rotation_euler=(target-o.location).to_track_quat('-Z','Y').to_euler()
area((1,-9,11),2200,8);area((10,-4,6),1300,7);area((4,5,10),1900,6)
scene.render.filepath=str(O/'employee-1-open-raw.png');receipt['status']='RENDERING';save()
bpy.ops.render.render(write_still=True)
receipt['status']='COMPLETE';receipt['rawImage']=scene.render.filepath;receipt['rawSHA256']=hashlib.sha256(pathlib.Path(scene.render.filepath).read_bytes()).hexdigest();receipt['finished']=time.time();save()
print('RECEIPT',json.dumps(receipt))
