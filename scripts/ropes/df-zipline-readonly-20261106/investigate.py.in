
import os,json,re,hashlib,struct,collections,glob,traceback
from pathlib import Path
O=Path('@@DF_PATH_DF_ZIPLINE_READONLY_20261106@@'); O.mkdir(exist_ok=True)
P=Path('@@DF_PATH_DF_EXTRACT_20261105@@/placements'); B=Path('@@DF_PATH_DF_V25_BUILD_20261106@@')
load=lambda p:json.loads(Path(p).read_text(encoding='utf-8-sig'))
rows=[json.loads(l) for l in (B/'component-work/selected-placements.jsonl').open(encoding='utf8')]
final=[json.loads(l) for l in (B/'component-work/final-combined-placements.jsonl').open(encoding='utf8')]
actorid=lambda x:x.split(':PersistentLevel.')[0]+':PersistentLevel.'+x.split(':PersistentLevel.')[1].split('.')[0]
z=[r for r in rows if 'Zipline' in r['objectPath']]
groups=collections.defaultdict(list)
for r in z:groups[actorid(r['objectPath'])].append(r)
models={r['objectPath']:r for r in map(json.loads,(B/'geometry-work/models.jsonl').open(encoding='utf8'))}
