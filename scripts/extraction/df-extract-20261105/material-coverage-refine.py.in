for base in [S/'materials',ROOT/'material-metadata-supplement/materials']:
 for f in base.rglob('*.json'):
  d=load(f);pkg=d.get('Package') or f.parent.relative_to(base).as_posix();d['_pkg']=pkg;objs[pkg+'.'+d['Name']]=d
